<resources>
    <style name="Theme.AtomosBridge" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#090B12</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.AtomosBridge.App</item>
    </style>
    <style name="Theme.AtomosBridge.App" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#9B8CFF</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#090B12</item>
        <item name="android:navigationBarColor">#090B12</item>
        <item name="android:windowBackground">#090B12</item>
    </style>
</resources>
